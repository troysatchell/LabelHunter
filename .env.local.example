# Copy this file to .env.local (gitignored) and fill in real values.
#
# In a factory ticket worktree, .env.local and .factory-env are provisioned
# automatically by scripts/factory/worktree.sh — you should not normally need
# to hand-edit this for ticket work. This file documents what's required for
# a plain `git clone` + local dev setup (TH-R13/TH-R14).

# Postgres connection string. See docs/PRD.md §3.6 (Postgres + Drizzle).
# Local dev: run a postgres container, e.g.
#   docker run --name labelhunter-pg -e POSTGRES_USER=labelhunter \
#     -e POSTGRES_PASSWORD=labelhunter_dev_password \
#     -e POSTGRES_DB=labelhunter_dev -p 127.0.0.1:5432:5432 -d postgres:16-alpine
#
# Bind to 127.0.0.1, not 0.0.0.0. A bare "-p 5432:5432" exposes Postgres,
# with this file's own example password, to every interface on the host.
DATABASE_URL=postgresql://labelhunter:labelhunter_dev_password@localhost:5432/labelhunter_dev

# Port the Next.js app listens on (next dev / next start).
PORT=3000

# Anthropic API key for the extraction/resolver cascade (PRD §3.1/§4).
# Wired up in a later ticket (CP-1) — not required for the scaffold.
# ANTHROPIC_API_KEY=

# Google API key for Gemini image generation. Dev-time only: golden-set
# backdrops + wild labels (LH-005). The running app never calls Google.
# GOOGLE_API_KEY=

# Shared access code that gates the whole app (TRO-482 / LH-061, PRD §8).
# src/proxy.ts checks every request for this value, by cookie or by the
# x-access-code header — see src/server/auth/access-code.ts. Required: with
# this unset (or empty), the gate fails CLOSED and every request is
# rejected, on purpose (an unset secret must never silently become an open
# endpoint).
#
# Ships EMPTY on purpose, not a placeholder string (TRO-567 finding 1):
# copying this file to .env.local verbatim, exactly as the instructions at
# the top of this file say to do, must never hand a reader a working code
# by accident. Fill in your own local value here for local dev only. The
# deployed instance never reads this file — it reads ACCESS_CODE from
# Render's own platform environment config, set once in the dashboard, and
# that real value never appears here or in README.md (CLAUDE.md: "No
# secrets in the repo").
ACCESS_CODE=

# Daily spend budget, in US dollars, for the Anthropic API calls this
# deployment makes (TRO-482 / LH-061, PRD §8). Once today's real, measured
# spend reaches this number, /api/verify and /api/batch/start refuse new
# work with a friendly message instead of calling the model — see
# src/server/budget/daily-budget.ts for the $5.00 default and the
# reasoning behind it. Optional: unset uses that default.
# DAILY_BUDGET_USD=5.00
