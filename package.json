    "@types/pg": "8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "js-yaml": "4.3.1",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
